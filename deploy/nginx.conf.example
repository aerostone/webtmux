# 放在 Nginx http {} 上下文中，例如 conf.d/webtmux.conf。
# 对应 webtmux 配置：listen_addr: 127.0.0.1:3400, base_path: /tmux,
# tls_enabled: false, trusted_proxy_cidrs: ["127.0.0.1/32"]。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name terminal.example.com;
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 如需浏览器客户端证书认证，在此 server 中启用：
    # ssl_client_certificate /etc/nginx/certs/browser-client-ca.pem;
    # ssl_verify_client on;
    # 客户端证书认证作用于整个 TLS listener，不能只在 path 内协商。

    location = /tmux {
        return 308 /tmux/$is_args$args;
    }

    location /tmux/ {
        # 不带尾部 /，保留 /tmux/ 前缀，由 webtmux 自己处理。
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 单层代理覆盖此头；多层代理需明确逐跳信任范围。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        client_max_body_size 100m;
    }
}
